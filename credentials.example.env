# Secrets do GitHub Actions no repositorio 2_ano_infra.
# Copie os valores do Learner Lab. Nao commite credentials.env.

AWS_ACCESS_KEY_ID=AKIA_MOCK_SUBSTITUA
AWS_SECRET_ACCESS_KEY=MOCK_SECRET_SUBSTITUA
AWS_SESSION_TOKEN=MOCK_SESSION_TOKEN_SUBSTITUA
AWS_DEFAULT_REGION=us-east-1

# Token com actions:read em 2_ano_backend, 2_ano_frontend e 2_ano_back_ia.
GH_PAT=github_pat_MOCK_SUBSTITUA

# Servico Postgres criado no console da Aiven. O sslmode=require e obrigatorio.
# Host, porta, usuario e senha estao na pagina de conexao do servico.
DB_URL=jdbc:postgresql://MOCK_AIVEN_HOST:MOCK_PORT/MOCK_DB?sslmode=require
DB_USERNAME=avnadmin
DB_PASSWORD=MOCK_AIVEN_PASSWORD
SECURITY_KEY=MOCK_SECURITY_KEY
EXPIRATION_TIME=3600

# Redis fora do cluster, no mesmo modelo da Aiven. A URL da Aiven usa rediss://.
REDIS_URL=rediss://MOCK_AIVEN_REDIS_USER:MOCK_AIVEN_REDIS_PASSWORD@MOCK_AIVEN_REDIS_HOST:MOCK_PORT

# Qdrant fora do cluster. URL e chave saem da pagina de conexao do servico.
QDRANT_URL=https://MOCK_QDRANT_HOST:6333
QDRANT_API_KEY=MOCK_QDRANT_API_KEY

# MongoDB Atlas. Em Connect, Drivers, copie a URI mongodb+srv.
MONGODB_URI=mongodb+srv://MOCK_ATLAS_USER:MOCK_ATLAS_PASSWORD@MOCK_CLUSTER.mongodb.net/Skadi?retryWrites=true&w=majority
